{
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(.*)(Discordbot|Twitterbot|facebookexternalhit|Facebot|WhatsApp|Slackbot|TelegramBot|LinkedInBot|SkypeUriPreview|redditbot|Embedly|Pinterest|Mastodon|Iframely|vkShare|Bluesky|Signal)(.*)"
        }
      ],
      "destination": "https://stbleaguedata.vercel.app/api/share"
    },
    {
      "source": "/STB/:path*",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(.*)(Discordbot|Twitterbot|facebookexternalhit|Facebot|WhatsApp|Slackbot|TelegramBot|LinkedInBot|SkypeUriPreview|redditbot|Embedly|Pinterest|Mastodon|Iframely|vkShare|Bluesky|Signal)(.*)"
        }
      ],
      "destination": "https://stbleaguedata.vercel.app/api/share/STB/:path*"
    },
    {
      "source": "/sitemap.xml",
      "destination": "https://stbleaguedata.vercel.app/api/sitemap"
    },
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ]
}
